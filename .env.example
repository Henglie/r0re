# Copy to .env and fill local values.
# Do not commit .env.

# Absolute path to this r0re checkout. setup-dev.sh fills this automatically.
R0RE_WORKSPACE=/absolute/path/to/r0re

# Kimi Code model credentials.
KIMI_MODEL_NAME=k3
KIMI_MODEL_PROVIDER_TYPE=anthropic
KIMI_MODEL_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL_API_KEY=
KIMI_MODEL_MAX_CONTEXT_SIZE=1048576

# Local r0re server.
R0RE_SERVER_PORT=8001
